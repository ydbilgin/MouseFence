#include <windows.h>

1 ICON "../../assets/app.ico"
1 RT_MANIFEST "res/app.manifest"

1 VERSIONINFO
 FILEVERSION 2,0,1,0
 PRODUCTVERSION 2,0,1,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "MouseFence - keeps the cursor on the screen you meant\0"
            VALUE "FileVersion", "2.0.1.0\0"
            VALUE "InternalName", "MouseFence\0"
            VALUE "LegalCopyright", "MIT\0"
            VALUE "OriginalFilename", "MouseFence.exe\0"
            VALUE "ProductName", "MouseFence\0"
            VALUE "ProductVersion", "2.0.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
