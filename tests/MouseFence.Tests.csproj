    <Compile Include="..\Core\GuardCore.Transitions.cs" Link="GuardCore.Transitions.cs" />
    <Compile Include="..\Core\HookHealth.cs" Link="HookHealth.cs" />
    <Compile Include="..\Core\BoundaryGraph.cs" Link="BoundaryGraph.cs" />
    <Compile Include="..\I18n\Strings.cs" Link="Strings.cs" />
    <Compile Include="..\I18n\Strings.En.cs" Link="Strings.En.cs" />
    <Compile Include="..\I18n\Strings.Tr.cs" Link="Strings.Tr.cs" />
    <Compile Include="..\Settings.cs" Link="Settings.cs" />
    <Compile Include="..\Core\MonitorInfo.cs" Link="MonitorInfo.cs" />
