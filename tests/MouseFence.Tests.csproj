<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>MouseFence.Tests</AssemblyName>
    <RootNamespace>MouseFence.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Don't pull in the council scratch sub-projects nested under tests/ -->
    <Compile Remove="council_*/**/*.cs" />
    <!-- Test the REAL production logic. The Windows target is needed only because Settings stores WinForms Keys. -->
    <Compile Include="..\GuardCore.cs" Link="GuardCore.cs" />
    <Compile Include="..\BoundaryGraph.cs" Link="BoundaryGraph.cs" />
    <Compile Include="..\Strings.cs" Link="Strings.cs" />
    <Compile Include="..\Settings.cs" Link="Settings.cs" />
    <Compile Include="..\MonitorInfo.cs" Link="MonitorInfo.cs" />
    <Compile Include="..\Native.cs" Link="Native.cs" />
    <Compile Include="..\SettingsForm.cs" Link="SettingsForm.cs" />
    <Compile Include="..\MonitorMapControl.cs" Link="MonitorMapControl.cs" />
    <Compile Include="..\IdentifyOverlay.cs" Link="IdentifyOverlay.cs" />
    <Compile Include="..\Theming.cs" Link="Theming.cs" />
    <Compile Include="..\Screenshot.cs" Link="Screenshot.cs" />
  </ItemGroup>

</Project>
